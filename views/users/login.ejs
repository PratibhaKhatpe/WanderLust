
<body>
    <div class="row-mt-3">
        <div class="col-6 offset-3"><h1>Login for WanderLust</h1></div>
        <div class="col-6 offset-3">
            <form action="/login" method="POST" class="needs-validation">
                <div class="mb-3 mt-4">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" id="username" placeholder="Enter your username" name="username" class="form-control" required>
                </div>
                <div class="mb-3 mt-4">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" id="password" placeholder="Enter password" name="password" class="form-control" required>
                </div>
                <button class="btn btn-success">Login</button>
            </form>
        </div>
    </div>
</body>